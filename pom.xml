    <build>
        <plugins>

            <!-- maven-compiler-plugin (release 21) inherited from cresco-parent; no JDK-internal (sun.*) APIs are used -->

            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <!-- version + extensions inherited from cresco-parent pluginManagement -->
                <configuration>
                    <instructions>
                        <Bundle-SymbolicName>${project.groupId}.${project.artifactId}</Bundle-SymbolicName>
                        <Bundle-Name>Cresco Controller</Bundle-Name>
                        <Bundle-Description>Controller for Cresco</Bundle-Description>
                        <Bundle-Vendor>Cresco.io</Bundle-Vendor>
                        <Bundle-Version>${project.version}-${maven.build.timestamp}</Bundle-Version>
                        <!-- NOTE: this Bundle-Activator is currently a no-op; the real entry point is the
                             AgentServiceImpl DS @Component. Kept as-is in Phase 0 to avoid changing the
                             critical bundle's lifecycle; candidate for removal once DS-only start is verified. -->
                        <Bundle-Activator>io.cresco.agent.core.Activator</Bundle-Activator>
                        <!-- Was malformed: "org.osgi.service.cm.ConfigurationAdmin;*;..." (a class where a
                             package was expected). Hard requirements: framework, Config Admin, Cresco SPI;
                             the large embedded runtime (ActiveMQ/Derby/Netty/BC) stays optional. -->
                        <Import-Package>
                            org.osgi.framework,
                            org.osgi.framework.*,
                            org.osgi.service.cm,
                            io.cresco.library.*,
                            *;resolution:=optional
                        </Import-Package>
                        <!-- scope=compile|runtime keeps test (junit, commons-logging) and provided jars out of the bundle -->
                        <Embed-Dependency>!org.osgi.*;!osgi.cmpn.*;!library;*;scope=compile|runtime</Embed-Dependency>
                    </instructions>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.22.2</version>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.4</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- attached to Maven test phase -->
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

